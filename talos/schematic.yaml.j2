customization:
    extraKernelArgs:
        - amd_pstate=active
        - pcie_aspm=off
        - talos.dashboard.disabled=1
        - zfs.zfs_arc_max=214748364800 # 200 GiB ARC cap (~51 GiB left for k8s apps and system; node reports 251.5 GiB)
    systemExtensions:
        officialExtensions:
            - siderolabs/amd-ucode
            - siderolabs/i915
            - siderolabs/mei
            - siderolabs/zfs